# /etc/robot-agent/robot-agent.env - settings for robot-agent.service (see README "环境变量").
# install.sh creates it once with a random ROBOT_AGENT_TOKEN and never overwrites it.

HOST=0.0.0.0
PORT=8000
# Required for access from other computers: open http://<PC4 IP>:8000/?token=<token>
ROBOT_AGENT_TOKEN=@TOKEN@

CC_BASE_URL=http://127.0.0.1:4000
CC_AUTH_TOKEN=sk-cc-github-litellm
CC_MODEL=claude-opus-5.5
#CC_MAX_TURNS=40
#ROBOT_APPROVAL_TIMEOUT=120

# Start mode (real|sim); the UI can switch it at runtime. ROBOT_MODE_LOCK pins it.
#ROBOT_MODE=real
#ROBOT_MODE_LOCK=sim

# Only if the robot's ROS 2 services use non-default values:
#ROS_DOMAIN_ID=0
#ROBOT_DDS_INTERFACE=eth0
